<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  
  <xacro:macro name="rover_gazebo" params="controllers_yaml">
    <gazebo>
      <plugin filename="ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin">
        <parameters>${controllers_yaml}</parameters>
      </plugin>
    </gazebo>

    <gazebo reference="base_link">
      <sensor name="chassis_contact" type="contact">
        <contact>
          <collision>base_footprint_fixed_joint_lump__base_link_collision</collision>
        </contact>
        <update_rate>10</update_rate>
        <topic>/chassis/contact_sensors</topic>
      </sensor>
    </gazebo>

  </xacro:macro>

  <xacro:macro name="depth_camera_gazebo" params="name">
    <gazebo reference="${name}_link">
      
      <sensor name="${name}_rgb" type="camera">
        <always_on>1</always_on>
        <visualize>false</visualize>
        <update_rate>5</update_rate>
        <topic>${name}/image_raw</topic>
        <camera>
          <horizontal_fov>1.91986</horizontal_fov> <image><width>640</width><height>360</height></image>
          <clip><near>0.2</near><far>300</far></clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev> 
          </noise>
        </camera>
      </sensor>

      <sensor name="${name}_depth" type="depth_camera">
        <always_on>1</always_on>
        <visualize>false</visualize>
        <update_rate>5</update_rate>
        <topic>${name}/depth</topic>
        <camera>
          <horizontal_fov>1.91986</horizontal_fov> <image><width>640</width><height>360</height></image>
          <clip><near>0.2</near><far>20</far></clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev> 
          </noise>
        </camera>
      </sensor>
      
    </gazebo>

  </xacro:macro>

  <xacro:macro name="bno055_imu_gazebo" params="name">
    <gazebo reference="${name}_link">
      
      <sensor name="${name}_imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <visualize>false</visualize>
        <topic>${name}/data</topic>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00173</stddev>
                <bias_mean>0.0175</bias_mean>
                <bias_stddev>0.001</bias_stddev>
                <dynamic_bias_stddev>0.0005</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>400.0</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00173</stddev>
                <bias_mean>0.0175</bias_mean>
                <bias_stddev>0.001</bias_stddev>
                <dynamic_bias_stddev>0.0005</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>400.0</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00173</stddev>
                <bias_mean>0.0175</bias_mean>
                <bias_stddev>0.001</bias_stddev>
                <dynamic_bias_stddev>0.0005</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>400.0</dynamic_bias_correlation_time>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0104</stddev>
                <bias_mean>0.785</bias_mean>
                <bias_stddev>0.01</bias_stddev>
                <dynamic_bias_stddev>0.005</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>400.0</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0104</stddev>
                <bias_mean>0.785</bias_mean>
                <bias_stddev>0.01</bias_stddev>
                <dynamic_bias_stddev>0.005</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>400.0</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0104</stddev>
                <bias_mean>0.785</bias_mean>
                <bias_stddev>0.01</bias_stddev>
                <dynamic_bias_stddev>0.005</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>400.0</dynamic_bias_correlation_time>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>

      <sensor name="${name}_mag_sensor" type="magnetometer">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <visualize>false</visualize>
        <topic>${name}/mag</topic>
        <magnetometer>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1e-06</stddev>
              <bias_mean>1.5e-05</bias_mean>
              <bias_stddev>1e-06</bias_stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1e-06</stddev>
              <bias_mean>-1.0e-05</bias_mean>
              <bias_stddev>1e-06</bias_stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.4e-06</stddev>
              <bias_mean>0.5e-05</bias_mean>
              <bias_stddev>1e-06</bias_stddev>
            </noise>
          </z>
        </magnetometer>
      </sensor>

    </gazebo>

  </xacro:macro>
  
</robot>