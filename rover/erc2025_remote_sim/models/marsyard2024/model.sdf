<?xml version="1.0" ?>

<sdf version="1.6">

<model name="marsyard2024">
  <static>true</static>
  <link name="scene_link">

    <!-- Visual -->
    <visual name="visual">
      <geometry>
        <mesh>
          <uri>model://marsyard2024/meshes/marsyard2024_processed.dae</uri>            
        </mesh>
      </geometry>
    </visual>

    <!-- Collision -->
    <collision name="collision">
      <geometry>
        <mesh>
          <uri>model://marsyard2024/meshes/marsyard2024_collision.stl</uri>            
        </mesh>
      </geometry>
      <surface>
        <contact>
          <ode>
            <max_vel>0.1</max_vel>
            <min_depth>0.001</min_depth>
          </ode>
        </contact>
      </surface>
    </collision>

  </link>
</model>

</sdf>