  <library_effects>
    <effect id="AR-effect">
      <profile_COMMON>
        <newparam sid="aruco_marker_png-surface">
          <surface type="2D">
            <init_from>aruco_marker_png</init_from>
          </surface>
        </newparam>
        <newparam sid="aruco_marker_png-sampler">
          <sampler2D>
            <source>aruco_marker_png-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="aruco_marker_png-sampler" texcoord="UVMap"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.45</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
