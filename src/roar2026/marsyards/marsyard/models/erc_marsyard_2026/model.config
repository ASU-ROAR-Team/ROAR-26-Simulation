<?xml version="1.0"?>
<model>
  <name>ERC Mars Yard 2026</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>Reem</name>
  </author>

  <description>
    Terrain model of the ERC (European Rover Challenge) 2026 Mars Yard,
    built from organizer-supplied photogrammetry data (mesh + orthophoto
    + control-point coordinates). The visual mesh is textured with the
    georeferenced orthophoto (UVs generated from the orthophoto's GeoTIFF
    transform, since none of the supplied mesh formats - OBJ/PLY/FBX -
    included UV coordinates). Coordinates are in the organizers' local
    survey frame: origin (0,0,0) = control point S1, +X and +Y as shown
    in Coord_Sys.pdf, height in meters.

    visual mesh:    ~200,000 tris  (decimated from ~1.68M for real-time rendering)
    collision mesh: ~15,000 tris   (decimated further for physics performance)
  </description>
</model>
