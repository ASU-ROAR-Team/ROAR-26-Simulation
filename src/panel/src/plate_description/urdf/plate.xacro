<?xml version="1.0" ?>
<robot name="plate" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find plate_description)/urdf/materials.xacro" />
<xacro:include filename="$(find plate_description)/urdf/plate.ros2control" />
<xacro:include filename="$(find plate_description)/urdf/plate.gazebo" />
<link name="plate_base_link">
  <inertial>
    <origin xyz="-2.8714913691515598e-15 0.0 0.006000000000000001" rpy="0 0 0"/>
    <mass value="1.6845023239511934"/>
    <inertia ixx="0.001433" iyy="0.00458" izz="0.005973" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz=" 0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find plate_description)/meshes/plate_base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
  <origin xyz=" 0 0 0" rpy="0 0 0"/> <geometry>
    <box size="0.175 0.095 0.010"/> 
  </geometry>
</collision>
</link>


</robot>
