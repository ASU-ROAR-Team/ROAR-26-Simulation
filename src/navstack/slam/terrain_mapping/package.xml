<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypename="packageFormat3"?>
<package format="3">
  <name>terrain_mapping</name>
  <version>0.1.0</version>
  <description>
    Terrain mapping node: loads a pre-baked height map from an offline .npz
    file as a trusted, immutable base, then verifies live obstacle detections
    against it with per-obstacle Kalman tracks before stamping them on top.
    Publishes OccupancyGrid (/map, /active_map/heightmap) + PointCloud2.
  </description>
  <maintainer email="user@todo.todo">user</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>sensor_msgs_py</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>active_mapping_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>roar_localization</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
