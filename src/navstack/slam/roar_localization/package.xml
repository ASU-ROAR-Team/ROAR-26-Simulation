<?xml version="1.0"?>
<package format="3">
  <name>roar_localization</name>
  <version>0.2.0</version>
  <description>
    IESKF-based localization for the ASU ROAR Team rover (ERC 2026).
    Fuses BNO055 IMU + wheel encoders + ZED2i visual odometry + ArUco landmarks,
    with FIS-based adaptive noise tuning and ZUPT for stationary drift collapse.
  </description>

  <maintainer email="mohamed.ashraf.eng2002@example.com">Mohamed Ashraf</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_msgs</depend>
  <depend>eigen</depend>
  <depend>yaml-cpp</depend>
  <depend>roar_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
