<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="sixdof_pkg">

  <xacro:macro name="robotic_arm" params="prefix parent_link *origin">

    <joint name="${prefix}mount_joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent_link}" />
      <child link="${prefix}base_link" />
    </joint>

    <material name="${prefix}black">
      <color rgba="0.1 0.1 0.1 1" />
    </material>
    <material name="${prefix}light_grey">
      <color rgba="0.894117647058823 0.894117647058823 0.894117647058823 1" />
    </material>

    <link name="${prefix}base_link">
      <inertial>
        <origin xyz="-1.4432899320127E-15 2.22044604925031E-16 0.0535613956407754" rpy="0 0 0" />
        <mass value="1.15555347830254" />
        <inertia ixx="0.00564248772536017" ixy="2.23835073756878E-18" ixz="1.97782448536564E-17" iyy="0.00564248772536017" iyz="2.69267408475459E-17" izz="0.00783180183404248" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://roar_simulation/meshes/arm/base_link.STL" />
        </geometry>
        <material name="${prefix}black" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://roar_simulation/meshes/arm/base_link.STL" />
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}joint_0" type="revolute">
      <origin xyz="0 0 0.1" rpy="0 0 0" />
      <parent link="${prefix}base_link" />
      <child link="${prefix}link_1" />
      <axis xyz="0 0 -1" />
      <limit lower="-3.1416" upper="3.1416" effort="150.0" velocity="1.0" />
      <dynamics damping="1.5" friction="1.0" />
    </joint>

    <link name="${prefix}link_1">
      <inertial>
        <origin xyz="-0.0184865009322647 -0.000343359104621799 0.043235728599564" rpy="0 0 0" />
        <mass value="0.453677114064451" />
        <inertia ixx="0.00111974761655116" ixy="-1.14036238802781E-05" ixz="0.000249743015977271" iyy="0.00174111218973293" iyz="-4.79405455261046E-05" izz="0.00193935919000532" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://roar_simulation/meshes/arm/link_1.STL" />
        </geometry>
        <material name="${prefix}light_grey" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://roar_simulation/meshes/arm/link_1.STL" />
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}joint_1" type="revolute">
      <origin xyz="0.0012324 0.021637 0.13613" rpy="1.5708 0 3.1416" />
      <parent link="${prefix}link_1" />
      <child link="${prefix}link_2" />
      <axis xyz="0 0 -1" />
      <limit lower="-2.635" upper="0.017" effort="300.0" velocity="1.0" />
      <dynamics damping="3.0" friction="2.0" />
    </joint>

    <link name="${prefix}link_2">
      <inertial>
        <origin xyz="0.110226578424505 0.160664206722328 -0.000129009428062377" rpy="0 0 0" />
        <mass value="0.373237892690951" />
        <inertia ixx="0.00450455596495297" ixy="-0.00277125789922948" ixz="2.94470092725727E-06" iyy="0.00242327638654859" iyz="-8.32445012055692E-07" izz="0.00673174330584051" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://roar_simulation/meshes/arm/link_2.STL" />
        </geometry>
        <material name="${prefix}light_grey" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://roar_simulation/meshes/arm/link_2.STL" />
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}joint_2" type="revolute">
      <origin xyz="0.22947 0.32763 0" rpy="0 0 3.1416" />
      <parent link="${prefix}link_2" />
      <child link="${prefix}link_3" />
      <axis xyz="0 0 -1" />
      <limit lower="-0.017" upper="3.159" effort="200.0" velocity="1.0" />
      <dynamics damping="2.0" friction="1.5" />
    </joint>

    <link name="${prefix}link_3">
      <inertial>
        <origin xyz="0.199424305800601 -0.031767148275585 -3.49158136492278E-06" rpy="0 0 0" />
        <mass value="0.194922382097793" />
        <inertia ixx="0.000107232320455328" ixy="0.000224139963386137" ixz="6.55556094803492E-10" iyy="0.00159885383649834" iyz="3.2240082559958E-11" izz="0.00163855555055975" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://roar_simulation/meshes/arm/link_3.STL" />
        </geometry>
        <material name="${prefix}black" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://roar_simulation/meshes/arm/link_3.STL" />
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}joint_3" type="revolute">
      <origin xyz="0.34473 -0.0081531 0" rpy="1.7099 1.5708 0" />
      <parent link="${prefix}link_3" />
      <child link="${prefix}link_4" />
      <axis xyz="0 0 -1" />
      <limit lower="-1.6581" upper="1.6581" effort="80.0" velocity="2.0" />
      <dynamics damping="1.0" friction="0.5" />
    </joint>

    <link name="${prefix}link_4">
      <inertial>
        <origin xyz="3.34798855305962E-12 8.76182015829841E-10 -0.0139382394101681" rpy="0 0 0" />
        <mass value="0.114029439170439" />
        <inertia ixx="5.19266249739107E-05" ixy="8.76055685114871E-17" ixz="3.65537360745813E-19" iyy="0.000441770546285855" iyz="3.24840881868156E-12" izz="0.000445393127603073" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://roar_simulation/meshes/arm/link_4.STL" />
        </geometry>
        <material name="${prefix}black" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://roar_simulation/meshes/arm/link_4.STL" />
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}joint_4" type="revolute">
      <origin xyz="0 0 -0.055294" rpy="1.5708 -0.13911 -1.5708" />
      <parent link="${prefix}link_4" />
      <child link="${prefix}link_5" />
      <axis xyz="0 0 -1" />
      <limit lower="-1.6581" upper="1.6581" effort="80.0" velocity="2.0" />
      <dynamics damping="1.0" friction="0.5" />
    </joint>

    <link name="${prefix}link_5">
      <inertial>
        <origin xyz="0.00170422253811797 0.0121708195854833 2.13671662985249E-06" rpy="0 0 0" />
        <mass value="0.178059332341805" />
        <inertia ixx="0.000496310569064639" ixy="5.86754065866815E-07" ixz="1.64657441768095E-10" iyy="0.000500419041395127" iyz="-2.28734941860973E-11" izz="6.97959742253889E-05" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://roar_simulation/meshes/arm/link_5.STL" />
        </geometry>
        <material name="${prefix}light_grey" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://roar_simulation/meshes/arm/link_5.STL" />
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}joint_5" type="revolute">
      <origin xyz="-0.008596 -0.061393 0" rpy="1.4317 -1.5708 0" />
      <parent link="${prefix}link_5" />
      <child link="${prefix}link_6" />
      <axis xyz="0 0 -1" />
      <limit lower="-1.6581" upper="1.6581" effort="80.0" velocity="2.0" />
      <dynamics damping="1.0" friction="0.5" />
    </joint>

    <link name="${prefix}link_6">
      <inertial>
        <origin xyz="7.29290900611801E-05 0.0142186365876996 0.0582099006241706" rpy="0 0 0" />
        <mass value="0.385258414727078" />
        <inertia ixx="0.000452279581941829" ixy="7.41755554498558E-05" ixz="6.92450881442413E-08" iyy="0.00126737361360787" iyz="3.0397662725544E-05" izz="0.00158152234846658" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://roar_simulation/meshes/arm/link_6.STL" />
        </geometry>
        <material name="${prefix}light_grey" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://roar_simulation/meshes/arm/link_6.STL" />
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}right_gripper" type="prismatic">
      <origin xyz="-0.0855 0.0175 0.1025" rpy="-1.5708 0.13911 -1.5708" />
      <parent link="${prefix}link_6" />
      <child link="${prefix}right_gripper_link" />
      <axis xyz="0 0 1" />
      <limit lower="0.0" upper="0.08" effort="40.0" velocity="0.2" />
    </joint>

    <link name="${prefix}right_gripper_link">
      <inertial>
        <origin xyz="0.0068713052626298 -0.0445833101194902 -0.00459919711816914" rpy="0 0 0" />
        <mass value="0.166407572042252" />
        <inertia ixx="0.000213014948987788" ixy="5.00427651888554E-06" ixz="1.31813153465416E-05" iyy="0.000193114100344925" iyz="-1.33531855818173E-05" izz="0.000283278991020372" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://roar_simulation/meshes/arm/right_gripper_link.STL" />
        </geometry>
        <material name="${prefix}black" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://roar_simulation/meshes/arm/right_gripper_link.STL" />
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}left_gripper" type="prismatic">
      <origin xyz="0.0165 -0.0175 0.1025" rpy="-1.5708 -0.13911 1.5708" />
      <parent link="${prefix}link_6" />
      <child link="${prefix}left_gripper_link" />
      <axis xyz="0 0 -1" />
      <limit lower="0.0" upper="0.08" effort="40.0" velocity="0.2" />
    </joint>

    <link name="${prefix}left_gripper_link">
      <inertial>
        <origin xyz="0.0203533878633443 -0.0405588468256447 -0.00445450235082778" rpy="0 0 0" />
        <mass value="0.170173837073524" />
        <inertia ixx="0.000210272947967754" ixy="8.64628656310733E-06" ixz="1.62782094288307E-05" iyy="0.000199729468619081" iyz="-8.68134344198002E-06" izz="0.000285711709281424" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://roar_simulation/meshes/arm/left_gripper_link.STL" />
        </geometry>
        <material name="${prefix}black" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://roar_simulation/meshes/arm/left_gripper_link.STL" />
        </geometry>
      </collision>
    </link>

    <gazebo reference="${prefix}base_link"><visual><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual></gazebo>
    <gazebo reference="${prefix}link_1"><visual><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual></gazebo>
    <gazebo reference="${prefix}link_2"><visual><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual></gazebo>
    <gazebo reference="${prefix}link_3"><visual><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual></gazebo>
    <gazebo reference="${prefix}link_4"><visual><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual></gazebo>
    <gazebo reference="${prefix}link_5"><visual><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual></gazebo>
    <gazebo reference="${prefix}link_6"><visual><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual></gazebo>

    <ros2_control name="${prefix}RobotSystem" type="system">
      <hardware>
        <xacro:if value="$(arg use_gazebo)">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>
        <xacro:if value="$(arg use_hardware)">
          <plugin>roar_hardware/RoarHardwareInterface</plugin>
        </xacro:if>
      </hardware>
      
      <joint name="${prefix}joint_0"><command_interface name="position" /><state_interface name="position" /></joint>
      <joint name="${prefix}joint_1">
        <command_interface name="position"><param name="initial_value">-1.0</param></command_interface>
        <state_interface name="position"><param name="initial_value">-1.0</param></state_interface>
      </joint>
      <joint name="${prefix}joint_2">
        <command_interface name="position"><param name="initial_value">1.57</param></command_interface>
        <state_interface name="position"><param name="initial_value">1.57</param></state_interface>
      </joint>
      <joint name="${prefix}joint_3">
        <command_interface name="position"><param name="initial_value">0.0</param></command_interface>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      </joint>
      <joint name="${prefix}joint_4"><command_interface name="position" /><state_interface name="position" /></joint>
      <joint name="${prefix}joint_5"><command_interface name="position" /><state_interface name="position" /></joint>
      <joint name="${prefix}left_gripper"><command_interface name="position" /><state_interface name="position" /></joint>
      <joint name="${prefix}right_gripper"><command_interface name="position" /><state_interface name="position" /></joint>
    </ros2_control>

  </xacro:macro>
</robot>
