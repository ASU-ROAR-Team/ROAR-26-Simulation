        <inertia ixx="0.0060529" ixy="-7.9663E-19" ixz="1.4318E-18" iyy="0.0060532" iyz="-3.072E-17" izz="0.0086379" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find roar_rover_clean)/meshes/arm/base_arm.STL" />
        </geometry>
        <material name="">
          <color rgba="0.79216 0.81961 0.93333 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find roar_rover_clean)/meshes/arm/base_arm.STL" />
        </geometry>
      </collision>
    </link>

