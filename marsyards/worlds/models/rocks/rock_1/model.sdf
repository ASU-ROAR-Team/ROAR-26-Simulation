<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="rock_1">
    <static>true</static>
    <link name="rock_link">

      <!-- Visual -->
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://rock_1/meshes/rock_1.obj</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://rock_1/meshes/rock_1_diffuse.jpg</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- Collision -->
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://rock_1/meshes/rock_1.obj</uri>
          </mesh>
        </geometry>
      </collision>

    </link>
  </model>
</sdf>