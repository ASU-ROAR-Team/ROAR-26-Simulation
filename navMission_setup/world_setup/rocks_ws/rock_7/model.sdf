<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="rock_7">
    <static>false</static>
    <link name="rock_link">
      <inertial>
        <mass>10.0</mass>
        <inertia>
          <ixx>0.1</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.1</iyy>
          <iyz>0.0</iyz>
          <izz>0.1</izz>
        </inertia>
      </inertial>
      <!-- Visual -->
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://rock_7/meshes/rock_7.obj</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://rock_5/meshes/rock_small_diffuse.jpg</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>
      <!-- Collision -->
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://rock_7/meshes/rock_7.obj</uri>
          </mesh>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>