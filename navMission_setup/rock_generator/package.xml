<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypattern="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rock_generator</name>
  <version>1.0.0</version>
  <description>ROS 2 package for generating obstacle data (.npy) and spawning parameterized rocks into Gazebo worlds for ROAR simulation missions.</description>
  <maintainer email="saif@roar.edu">Saif / ROAR Simulation Team</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>
  <depend>worlds</depend>
  <depend>marsyard</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pil</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
